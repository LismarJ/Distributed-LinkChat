# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
uv.lock

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Client data: identity keys, ratchet state and message history.
# Never commit any of this. It is the one copy of a user's conversations, and
# the keys in it are not recoverable.
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Secrets
.env
*.pem
ray_auth_token
auth_token

# Frontend
node_modules/
# NOTE: src/linkchat/client_app/static/ was ignored here until 2026-11-24, back
# when the build output was not meant to be committed. It now holds the
# committed Vite build of frontend/ (ADR-0017), so it must be tracked.
# Ignoring it had two consequences worth remembering: the files were missing
# from the repository, and hatchling honours this file when it builds the
# wheel, so `pip install .` shipped a client with no UI at all and the
# container served nothing. Do not re-add it.

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Archives: docs/docs.rar was committed by accident once. Keep sources, not bundles.
*.rar
*.zip
*.7z
